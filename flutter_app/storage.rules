rules_version = '2';

// DyadeSpace v2 storage.
// Every user is an invited crew member with an account, so any
// signed-in user may read (task proof, run stops, reports, chat
// media). Writes are images only, capped at 10 MB per file —
// except chat media, which also accepts video and audio (chat
// videos and voice notes), same 10 MB cap. Profile photos live
// at profilePhotos/<uid>.jpg and only their owner may write
// them.
//
// There is deliberately NO catch-all path: every writable
// folder is listed below, so an upload to a random path
// (e.g. /secrets/...) is denied. The real app paths, verified
// against lib/:
//   taskPhotos/<taskId>/<timestamp>.jpg  (PhotoService, task screen)
//   runPhotos/<runId>/<timestamp>.jpg   (PhotoService, run screen)
//   chatMedia/<conversationId>/<messageId>.<ext>
//   profilePhotos/<uid>.jpg
//
// Limitation: Storage rules cannot read Firestore, so the
// users-doc `active` flag cannot be checked here — access is
// signed-in-only at this layer, and Firestore rules plus the
// app enforce active-membership for the data itself.
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: one file per user, profilePhotos/<uid>.jpg.
    // Signed-in read for everyone; write/delete only by the
    // user whose uid is in the file name, image only, <10 MB.
    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }
    // Chat media: photos, videos and voice notes in
    // chatMedia/<conversationId>/<messageId>.<ext>.
    // No client delete: the path carries no uploader uid, so
    // Storage rules cannot tell the uploader from any other
    // signed-in user, and any-signed-in delete let anyone
    // break every bubble pointing at the file. Nothing in the
    // app deletes chat media (messages are immutable), so
    // client delete is simply denied; cleanup, if ever needed,
    // goes through the console / Admin SDK, which bypass rules.
    match /chatMedia/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('audio/.*'));
      allow delete: if false;
    }
    // Task photos: taskPhotos/<taskId>/<timestamp>.jpg, via
    // PhotoService.uploadFile('taskPhotos', task.id).
    // Image only, <10 MB. No client delete, for the same
    // reason as chatMedia: no uploader uid in the path, and
    // the app never deletes task photos.
    match /taskPhotos/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
    // Run photos: runPhotos/<runId>/<timestamp>.jpg, via
    // PhotoService.uploadFile('runPhotos', run.id).
    // Image only, <10 MB. No client delete, for the same
    // reason as chatMedia: no uploader uid in the path, and
    // the app never deletes run photos.
    match /runPhotos/{runId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
