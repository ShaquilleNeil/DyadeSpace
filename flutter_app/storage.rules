rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function myRole() {
      return firestore.get(/databases/(default)/documents/employees/$(request.auth.uid)).data.role;
    }

    function myProjectIds() {
      return firestore.get(/databases/(default)/documents/employees/$(request.auth.uid)).data.projectIds;
    }

    function isAdminOrManager() {
      return request.auth != null && (myRole() == 'admin' || myRole() == 'manager');
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /project_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }

    match /task_photos/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (isAdminOrManager() ||
         request.auth.uid in firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.assigneeIds);
    }

    match /material_request_photos/{requestId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /daily_report_photos/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
