rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return isSignedIn() && myRole() == 'manager';
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /employees/{uid} {
      allow read: if isSignedIn();

      // Signup: a user may create only their own employee doc.
      allow create: if isSignedIn() && request.auth.uid == uid;

      // Self-updates are allowed, but only a manager may change `role`.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        (onlyChangedFields(['firstName', 'lastName', 'phone', 'email', 'avatarUrl']) || isManager());

      allow delete: if isManager();
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManager();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isManager();

      // Managers can update any field; an assigned employee may only update `status`.
      allow update: if isManager() ||
        (isSignedIn() &&
         request.auth.uid in resource.data.assigneeIds &&
         onlyChangedFields(['status']));
    }
  }
}
